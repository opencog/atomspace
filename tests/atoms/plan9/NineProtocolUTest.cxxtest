#include <opencog/atoms/plan9/Nine9P.h>

#include <stdexcept>

#include <cxxtest/TestSuite.h>

using namespace opencog::plan9;

class NineProtocolUTest : public CxxTest::TestSuite
{
public:
	void test_version_roundtrip(void)
	{
		NineMsg m;
		m.type = Tversion;
		m.tag = NINE_NOTAG;
		m.msize = 8192;
		m.version = "9P2000";

		std::string wire = nine_encode(m);
		NineMsg back;
		size_t used = nine_decode(wire, back);

		TS_ASSERT_EQUALS(used, wire.size());
		TS_ASSERT_EQUALS(back.type, Tversion);
		TS_ASSERT_EQUALS(back.tag, NINE_NOTAG);
		TS_ASSERT_EQUALS(back.msize, 8192u);
		TS_ASSERT_EQUALS(back.version, "9P2000");
	}

	void test_incomplete_message_returns_zero(void)
	{
		NineMsg m;
		m.type = Tattach;
		m.tag = 7;
		m.fid = 1;
		m.afid = NINE_NOFID;
		m.uname = "user";
		m.aname = "";

		std::string wire = nine_encode(m);
		std::string truncated = wire.substr(0, wire.size() - 2);

		NineMsg back;
		TS_ASSERT_EQUALS(nine_decode(truncated, back), 0u);
	}

	void test_attach_roundtrip(void)
	{
		NineMsg m;
		m.type = Tattach;
		m.tag = 3;
		m.fid = 42;
		m.afid = NINE_NOFID;
		m.uname = "atomspace";
		m.aname = "/";

		NineMsg back;
		TS_ASSERT_EQUALS(nine_decode(nine_encode(m), back), nine_encode(m).size());
		TS_ASSERT_EQUALS(back.fid, 42u);
		TS_ASSERT_EQUALS(back.afid, NINE_NOFID);
		TS_ASSERT_EQUALS(back.uname, "atomspace");
		TS_ASSERT_EQUALS(back.aname, "/");
	}

	void test_walk_roundtrip(void)
	{
		NineMsg m;
		m.type = Twalk;
		m.tag = 5;
		m.fid = 1;
		m.newfid = 2;
		m.wname = { "by-type", "ConceptNode" };

		NineMsg back;
		nine_decode(nine_encode(m), back);
		TS_ASSERT_EQUALS(back.wname.size(), 2u);
		TS_ASSERT_EQUALS(back.wname[0], "by-type");
		TS_ASSERT_EQUALS(back.wname[1], "ConceptNode");
	}

	void test_rwalk_qid_roundtrip(void)
	{
		NineMsg m;
		m.type = Rwalk;
		m.tag = 5;
		NineQid q1; q1.type = QTDIR; q1.version = 0; q1.path = 111;
		NineQid q2; q2.type = QTFILE; q2.version = 1; q2.path = 222;
		m.wqid = { q1, q2 };

		NineMsg back;
		nine_decode(nine_encode(m), back);
		TS_ASSERT_EQUALS(back.wqid.size(), 2u);
		TS_ASSERT(back.wqid[0] == q1);
		TS_ASSERT(back.wqid[1] == q2);
	}

	void test_read_write_roundtrip(void)
	{
		NineMsg w;
		w.type = Twrite;
		w.tag = 9;
		w.fid = 4;
		w.offset = 16;
		w.data = "hello, 9p";

		NineMsg back;
		nine_decode(nine_encode(w), back);
		TS_ASSERT_EQUALS(back.fid, 4u);
		TS_ASSERT_EQUALS(back.offset, 16u);
		TS_ASSERT_EQUALS(back.data, "hello, 9p");

		NineMsg r;
		r.type = Rread;
		r.tag = 9;
		r.data = "reply data";

		NineMsg rback;
		nine_decode(nine_encode(r), rback);
		TS_ASSERT_EQUALS(rback.data, "reply data");
	}

	void test_error_roundtrip(void)
	{
		NineMsg m = nine_error(11, "no such file");
		NineMsg back;
		nine_decode(nine_encode(m), back);
		TS_ASSERT_EQUALS(back.type, Rerror);
		TS_ASSERT_EQUALS(back.tag, 11);
		TS_ASSERT_EQUALS(back.ename, "no such file");
	}

	void test_stat_roundtrip(void)
	{
		NineStat st;
		st.type = 0;
		st.dev = 0;
		st.qid.type = QTDIR;
		st.qid.version = 0;
		st.qid.path = 99;
		st.mode = NINE_DMDIR | 0555;
		st.atime = 0;
		st.mtime = 0;
		st.length = 0;
		st.name = "by-type";
		st.uid = "atomspace";
		st.gid = "atomspace";
		st.muid = "atomspace";

		std::string blob = nine_encode_stat(st);
		NineStat back = nine_decode_stat(blob);

		TS_ASSERT_EQUALS(back.name, "by-type");
		TS_ASSERT_EQUALS(back.mode, st.mode);
		TS_ASSERT(back.qid == st.qid);
		TS_ASSERT_EQUALS(back.uid, "atomspace");
	}

	void test_stat_message_roundtrip(void)
	{
		NineStat st;
		st.qid.type = QTFILE;
		st.qid.path = 7;
		st.mode = 0444;
		st.length = 5;
		st.name = "tv";
		st.uid = st.gid = st.muid = "atomspace";

		NineMsg m;
		m.type = Rstat;
		m.tag = 2;
		m.stat = nine_encode_stat(st);

		NineMsg back;
		nine_decode(nine_encode(m), back);
		NineStat st_back = nine_decode_stat(back.stat);
		TS_ASSERT_EQUALS(st_back.name, "tv");
		TS_ASSERT_EQUALS(st_back.length, 5u);
	}

	void test_unknown_message_type_throws_on_encode(void)
	{
		NineMsg m;
		m.type = 0xEE;
		TS_ASSERT_THROWS(nine_encode(m), std::runtime_error);
	}
};
