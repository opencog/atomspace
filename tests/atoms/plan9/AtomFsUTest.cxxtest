#include <opencog/atoms/plan9/AtomFs.h>
#include <opencog/atoms/plan9/NineNamespace.h>
#include <opencog/atoms/value/FloatValue.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/util/Logger.h>

#include <cxxtest/TestSuite.h>

using namespace opencog;
using namespace opencog::plan9;

namespace
{
NineNodePtr find_child(const NineNodePtr& dir, const std::string& name)
{
	if (not dir) return nullptr;
	for (const auto& c : dir->children())
		if (c->name() == name) return c;
	return nullptr;
}
} // namespace

class AtomFsUTest : public CxxTest::TestSuite
{
private:
	AtomSpacePtr _as;

public:
	AtomFsUTest(void)
	{
		logger().set_level(Logger::INFO);
		logger().set_print_to_stdout_flag(true);
	}

	void setUp(void)
	{
		_as = createAtomSpace();
	}

	void test_by_handle_lists_atoms(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "apple");
		Handle b = _as->add_node(CONCEPT_NODE, "banana");

		AtomFsIndex idx(_as);
		NineNamespace ns(idx.root());

		NineNodePtr by_handle = ns.walk("/by-handle");
		TS_ASSERT(by_handle != nullptr);
		TS_ASSERT(by_handle->is_dir());

		NineNodePtr adir = find_child(by_handle, AtomFsIndex::id_of(a));
		NineNodePtr bdir = find_child(by_handle, AtomFsIndex::id_of(b));
		TS_ASSERT(adir != nullptr);
		TS_ASSERT(bdir != nullptr);

		NineNodePtr name_file = find_child(adir, "name");
		TS_ASSERT(name_file != nullptr);
		TS_ASSERT_EQUALS(name_file->read(0, 1000), "apple\n");
	}

	void test_by_type_groups_atoms(void)
	{
		_as->add_node(CONCEPT_NODE, "x");
		_as->add_node(PREDICATE_NODE, "pred");

		AtomFsIndex idx(_as);
		NineNamespace ns(idx.root());

		NineNodePtr concept_dir = ns.walk("/by-type/ConceptNode");
		TS_ASSERT(concept_dir != nullptr);
		TS_ASSERT(concept_dir->is_dir());
		TS_ASSERT_EQUALS(concept_dir->children().size(), 1u);
	}

	void test_outgoing_incoming_are_hard_links(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "a");
		Handle b = _as->add_node(CONCEPT_NODE, "b");
		Handle link = _as->add_link(LIST_LINK, a, b);

		AtomFsIndex idx(_as);
		NineNamespace ns(idx.root());

		NineNodePtr link_dir = ns.walk("/by-handle/" + AtomFsIndex::id_of(link));
		TS_ASSERT(link_dir != nullptr);

		NineNodePtr outgoing = find_child(link_dir, "outgoing");
		TS_ASSERT(outgoing != nullptr);
		NineNodePtr elt0 = find_child(outgoing, "0");
		TS_ASSERT(elt0 != nullptr);

		NineNodePtr a_dir = ns.walk("/by-handle/" + AtomFsIndex::id_of(a));
		TS_ASSERT(a_dir != nullptr);

		// outgoing/0 of the link and by-handle/<a> must be the exact
		// same underlying file -- proven by Qid equality, the real
		// Plan 9 test for "is this the same file".
		TS_ASSERT(elt0->qid() == a_dir->qid());

		NineNodePtr a_incoming = find_child(a_dir, "incoming");
		TS_ASSERT(a_incoming != nullptr);
		NineNodePtr back_link = find_child(a_incoming, AtomFsIndex::id_of(link));
		TS_ASSERT(back_link != nullptr);
		TS_ASSERT(back_link->qid() == link_dir->qid());
	}

	void test_tv_file_read_and_write(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "scored");

		AtomFsIndex idx(_as);
		NineNamespace ns(idx.root());

		NineNodePtr tv = ns.walk(
			"/by-handle/" + AtomFsIndex::id_of(a) + "/tv");
		TS_ASSERT(tv != nullptr);
		TS_ASSERT(tv->is_writable());

		// Default (no truth_key() value set yet).
		TS_ASSERT_EQUALS(tv->read(0, 100), "1 0\n");

		TS_ASSERT_EQUALS(tv->write(0, "0.75 0.9"), 8u);
		std::string got = tv->read(0, 100);
		TS_ASSERT(got.find("0.75") != std::string::npos);
		TS_ASSERT(got.find("0.9") != std::string::npos);
	}

	void test_tv_file_not_writable_when_readonly(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "locked");
		AtomFsIndex idx(_as);
		NineNamespace ns(idx.root());
		NineNodePtr tv = ns.walk(
			"/by-handle/" + AtomFsIndex::id_of(a) + "/tv");
		TS_ASSERT(tv->is_writable());

		_as->set_read_only();
		TS_ASSERT(not tv->is_writable());
	}

	void test_values_directory_lists_keys(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "valued");
		Handle key = _as->add_node(PREDICATE_NODE, "my-key");
		a->setValue(key, createFloatValue(std::vector<double>({4.2})));

		AtomFsIndex idx(_as);
		NineNamespace ns(idx.root());
		NineNodePtr values = ns.walk(
			"/by-handle/" + AtomFsIndex::id_of(a) + "/values");
		TS_ASSERT(values != nullptr);

		NineNodePtr entry = find_child(values, AtomFsIndex::id_of(key));
		TS_ASSERT(entry != nullptr);
		TS_ASSERT(entry->read(0, 1000).find("4.2") != std::string::npos);
	}

	void test_structural_sheaf_hook_populates_sheaf_dir(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "a");
		Handle b = _as->add_node(CONCEPT_NODE, "b");
		Handle link = _as->add_link(LIST_LINK, a, b);

		SheafHookPtr hook(new StructuralSheafHook());
		AtomFsIndex idx(_as, hook);
		NineNamespace ns(idx.root());

		NineNodePtr sheaf = ns.walk(
			"/by-handle/" + AtomFsIndex::id_of(link) + "/sheaf");
		TS_ASSERT(sheaf != nullptr);

		NineNodePtr count = find_child(sheaf, "count");
		TS_ASSERT(count != nullptr);
		TS_ASSERT_EQUALS(count->read(0, 10), "2\n");

		// A bare node with no outgoing set gets no sheaf/ directory
		// at all under the structural hook.
		NineNodePtr a_sheaf = ns.walk(
			"/by-handle/" + AtomFsIndex::id_of(a) + "/sheaf");
		TS_ASSERT(a_sheaf == nullptr);
	}

	void test_no_hook_means_no_sheaf_dir(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "a");
		Handle b = _as->add_node(CONCEPT_NODE, "b");
		Handle link = _as->add_link(LIST_LINK, a, b);

		AtomFsIndex idx(_as); // no hook
		NineNamespace ns(idx.root());
		TS_ASSERT(ns.walk(
			"/by-handle/" + AtomFsIndex::id_of(link) + "/sheaf") == nullptr);
	}

	void test_handle_for_id_reverse_lookup(void)
	{
		Handle a = _as->add_node(CONCEPT_NODE, "findme");
		AtomFsIndex idx(_as);

		Handle found;
		TS_ASSERT(idx.handle_for_id(AtomFsIndex::id_of(a), found));
		TS_ASSERT_EQUALS(found, a);

		Handle nope;
		TS_ASSERT(not idx.handle_for_id("0000000000000000", nope));
	}

	void test_new_control_file_is_writable(void)
	{
		AtomFsIndex idx(_as);
		NineNamespace ns(idx.root());
		NineNodePtr ctl = ns.walk("/new");
		TS_ASSERT(ctl != nullptr);
		TS_ASSERT(ctl->is_writable());
	}
};
